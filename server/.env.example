# MongoDB Configuration
# Get your connection string from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carconnect?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong secret key for production (e.g., using openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration (optional)
LOG_LEVEL=info
ENABLE_LOGGING=true

# Firebase Admin (push notifications) — use ONE of:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./motonode-admin.json
FIREBASE_SERVICE_ACCOUNT_PATH=./motonode-admin.json

# Login greeting push — Motonode logo (HTTPS). Run: npm run upload:greeting-logo
# GREETING_NOTIFICATION_IMAGE_URL=https://res.cloudinary.com/your-cloud/image/upload/.../logo.png

# MSG91 OTP (phone login) — https://msg91.com/
# Local dev: use auth key WITH IP whitelist. Vercel prod: separate key WITHOUT IP lock (see MSG91_OTP_AUTH.md).
MSG91_API_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_otp_template_id
# Optional: DLT template entity ID for India (if required by your MSG91 plan)
# MSG91_DLT_TE_ID=your_dlt_template_entity_id
MSG91_OTP_LENGTH=6
MSG91_COUNTRY_CODE=91
OTP_EXPIRY_MINUTES=5
OTP_SEND_LIMIT=3
OTP_SEND_WINDOW_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_REGISTRATION_TOKEN_EXPIRES_IN=15m

# Razorpay (UPI / card checkout) — https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_; live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
# Optional label: test | live
RAZORPAY_ENV=test
# Optional: HTTPS logo on Razorpay checkout (defaults to GREETING_NOTIFICATION_IMAGE_URL)
# RAZORPAY_CHECKOUT_IMAGE_URL=https://res.cloudinary.com/.../logo.png
# Razorpay Dashboard → Webhooks → URL (must match server route in index.ts):
# POST https://api.motonode.in/api/webhooks/razorpay
# Active events: payment.captured, payment.failed, order.paid
